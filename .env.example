# Salin menjadi .env lalu isi.
DOMAIN=domain-anda.go.id
# 1 = cookie hanya lewat HTTPS (wajib untuk produksi). Set 0 hanya untuk uji lewat http://IP
COOKIE_SECURE=1

SITE_NAME=Komdigi Provinsi Lampung
SITE_TAGLINE=Portal informasi dan layanan digital Pemerintah Provinsi Lampung
SITE_DOMAIN=domain-anda.go.id
CONTACT_EMAIL=info@domain-anda.go.id
CONTACT_PHONE=(0721) 000 000
CONTACT_ADDRESS=Jl. Contoh No. 1, Bandar Lampung, Lampung
CONTACT_HOURS=Senin sampai Jumat, 08.00 sampai 16.00 WIB

# Akun admin pertama (dibuat hanya saat database masih kosong). Minimal 12 karakter.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Kosongkan agar dibuat otomatis dan disimpan di volume data. Atau isi string acak >= 32 karakter.
SECRET_KEY=
