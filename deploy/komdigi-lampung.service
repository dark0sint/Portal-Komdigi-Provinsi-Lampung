[Unit]
Description=Portal Komdigi Provinsi Lampung
After=network.target

[Service]
User=komdigi
WorkingDirectory=/opt/komdigi-lampung
EnvironmentFile=/opt/komdigi-lampung/.env
Environment=DATA_DIR=/var/lib/komdigi-lampung COOKIE_SECURE=1
ExecStart=/opt/komdigi-lampung/venv/bin/gunicorn --preload -w 3 -b 127.0.0.1:8000 app:app
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/komdigi-lampung
PrivateTmp=true

[Install]
WantedBy=multi-user.target
